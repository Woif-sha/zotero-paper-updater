{
  "skillName": "zotero-paper-updater",
  "contract": "This deterministic dataset is a routing regression proxy for the documented boundary; it is not a measured model trigger rate.",
  "queries": [
    {
      "id": "maintain-all",
      "pairId": 1,
      "query": "E:\\paper 里的 PDF 都已经是 Zotero 附件了。帮我跑一遍全库维护：补能精确确认的书目信息、同步本地文件名，并处理证据完整的重复项；无法确认的留在结果里。",
      "shouldTrigger": true,
      "expectedRoute": "workflows/maintain-library.md",
      "expectedOwner": "zotero-paper-updater",
      "boundaryReason": "Maintains existing library state."
    },
    {
      "id": "summarize-library",
      "pairId": 1,
      "query": "E:\\paper 里的 PDF 都已经是 Zotero 附件了。按研究主题把这些论文分组，逐组总结主要结论和方法差异，不要改动库。",
      "shouldTrigger": false,
      "expectedRoute": null,
      "expectedOwner": "content-summary",
      "boundaryReason": "Requests content synthesis without maintenance."
    },
    {
      "id": "maintain-item",
      "pairId": 2,
      "query": "只维护 Zotero 条目 8KJ4M2QX：它的期刊和页码有空值，本地副本名也可能落后；使用现有条目，不要新建记录。",
      "shouldTrigger": true,
      "expectedRoute": "workflows/maintain-library.md",
      "expectedOwner": "zotero-paper-updater",
      "boundaryReason": "Maintains one existing item."
    },
    {
      "id": "read-item",
      "pairId": 2,
